#import "../style.typ": *

= Glossary <app-glossary>

Terms in order of first appearance, with the chapter that defines them.

#small-table(
  columns: (auto, rest, auto),
  [*Term*], [*One-line meaning*], [*Where*],
  [Balance patch], [A game update that changes cards' numbers or rules], [@ch-project],
  [Card change], [One card's difference between two versions of the game], [@ch-project],
  [Run], [One game, from the first floor to a win or a death], [@ch-project],
  [Numeric tweak], [A change to a number on a card, rules unchanged], [@ch-project],
  [Rework], [A change to what a card does], [@ch-project],
  [Dose], [The size of a numeric tweak, on a fixed ruler], [@ch-project, @ch-dose],
  [Key; numbers table], [The name of one number in the guide; the generated table of every number with its source], [@ch-project],
  [Digit lint; listing], [The check that no digit was typed into a chapter; source code extracted when the guide is built], [@ch-project],
  [Run file (record)], [The uploaded log of one run], [@ch-data],
  [Reward screen], [The choice of cards the game shows after a fight], [@ch-data],
  [Offer], [One card shown on a reward screen; picked or not], [@ch-data],
  [Build], [One game version, such as v0.103.2], [@ch-data],
  [Stable and beta branch], [The main release and the opt-in early-test release], [@ch-data],
  [Patch window; before and after block], [The builds compared around one change], [@ch-data],
  [Snapshot], [The downloaded copy of the export when the download finished], [@ch-data],
  [Backfill (upload lag)], [Runs uploaded long after they were played], [@ch-data],
  [Uploader group (tagged, untagged)], [Runs uploaded through the SlayTheStats mod, or not], [@ch-data],
  [Duplicate record; run key], [The same run uploaded twice; the label that finds it], [@ch-data],
  [Keyed hash (HMAC); dictionary attack], [A hash mixed with a secret key; reversing a plain hash by hashing every candidate], [@ch-data],
  [Retried run], [Copies of one run with different endings], [@ch-data],
  [Sample and population], [The runs you have, and all the runs the question is about], [@ch-data],
  [Primary population], [The runs the main analysis uses, by fixed filters], [@ch-data],
  [Thin build; pooling], [A build too small to stand alone; counting it with a same-branch neighbour], [@ch-data],
  [Outcome], [What you measure (picked, won)], [@ch-confounding],
  [Treatment], [What you want the effect of (the patch, taking a card)], [@ch-confounding],
  [Confounder], [Something that drives both treatment and outcome (skill)], [@ch-confounding],
  [Selection], [Treated and untreated differ because of who chose], [@ch-confounding],
  [Causal effect; counterfactual], [What would change if only the treatment flipped; the world where it did], [@ch-confounding],
  [Potential outcomes], [A unit's outcome with and without the treatment; only one is ever seen], [@ch-confounding],
  [ATE; ATT], [The average effect over every unit; over the treated units only], [@ch-confounding],
  [Selection bias], [How differently the treated and untreated would have done without the treatment], [@ch-confounding],
  [Pick rate; P(picked | offered)], [Picks divided by offers; the chance an offer is taken], [@ch-counting],
  [Bernoulli trial; estimator], [One yes-or-no outcome with a fixed chance; a recipe that turns data into a guess], [@ch-counting],
  [Percentage points against percent], [Subtracting rates against dividing them], [@ch-counting],
  [Mean; median], [The average; the middle value], [@ch-counting],
  [Variance; standard deviation], [How spread out values are; p(1 − p) for a yes-or-no outcome], [@ch-counting],
  [Root-mean-square (RMS); mean absolute deviation (MAD)], [Square, average, root: the SD; the plain average distance], [@ch-counting],
  [Plug-in estimate], [Using the estimate in place of the unknown true value in a formula], [@ch-counting],
  [Standard error (SE)], [How far an estimate would move on a fresh sample], [@ch-noise],
  [Square-root rule], [The SE shrinks with the square root of the sample size], [@ch-noise],
  [Independent], [Knowing one outcome tells you nothing about the other], [@ch-noise],
  [Sampling distribution; bootstrap], [An estimate's histogram over imagined reruns; resampling the data to mimic them], [@ch-noise],
  [Law of large numbers; central limit theorem], [The estimate homes in on the truth; its scatter at a given size is a bell], [@ch-noise],
  [Normal distribution; standard normal], [The bell curve; the one with centre zero and SD one], [@ch-noise],
  [95% confidence interval], [The estimate plus or minus about two SEs], [@ch-noise],
  [z], [The estimate divided by its SE], [@ch-noise],
  [Clearly nonzero], [|z| > 2; calibrated version in @ch-placebo], [@ch-noise],
  [In quadrature; limiting side], [Adding errors as squares; the noisier piece of a difference, which sets its floor], [@ch-noise],
  [Wilson interval], [An interval for a rate that stays sensible at small counts], [@ch-noise],
  [Prior; posterior; Beta distribution], [Beliefs about a rate before and after the data; the curve family that holds them], [@ch-noise],
  [Precision; accuracy], [How little an estimate wobbles; how close its centre is to the truth], [@ch-noise],
  [Mean squared error; bias–variance tradeoff], [Bias squared plus variance; buying one with the other], [@ch-noise],
  [Bias], [A systematic error that more data doesn't fix], [@ch-noise],
  [Multiple comparisons], [Test enough things and some pass by luck], [@ch-noise],
  [Difference-in-differences (DiD)], [The treated card's change minus the controls' change], [@ch-did],
  [Treated card; control cards], [The changed card; unchanged same-character cards], [@ch-did],
  [Control exclusions], [Same-character cards changed in the window, left out], [@ch-did],
  [Parallel trends], [Without the patch, the treated card would have moved like its controls], [@ch-did],
  [Fixed horizon (weeks 0–3)], [Only the first four after-weeks count], [@ch-did],
  [Skip rate; drift], [Screens where nothing is taken; slow change unrelated to the patch], [@ch-did],
  [Spillover (substitution); SUTVA; interference], [A change to one card moves others; the assumption that it doesn't; the general name], [@ch-did],
  [Estimand], [The exact quantity an estimate is meant to measure], [@ch-did],
  [Card type; type-level placebo], [Attack, skill or power; unchanged cards of one type against another], [@ch-did],
  [Regression; coefficient (β)], [A fitted relation; the effect of one input], [@ch-regression],
  [Linear probability model], [A regression on a yes-or-no outcome], [@ch-regression],
  [Fixed effects; singleton], [A separate baseline per group; a group with one observation], [@ch-regression],
  [iid, robust and clustered SE], [Error bars assuming independence; unequal noise; related offers within a run], [@ch-regression],
  [Odds; log-odds; delta method], [Picks per pass; their log; converting an SE between scales], [@ch-regression],
  [Least squares (OLS); residual], [The line with the smallest sum of squared misses; one observation's miss], [@ch-regression],
  [Saturated model], [One number per cell, so it reproduces every cell average], [@ch-regression],
  [Design matrix; normal equations], [The inputs as a table, one column per coefficient; the equations least squares solves], [@ch-regression],
  [Frisch–Waugh–Lovell], [The coefficient on one input is the slope of leftovers on leftovers, once the others are removed], [@ch-regression],
  [Composition], [Which cards (or acts, levels) make up a group's offers], [@ch-regression],
  [Sandwich: bread and meat], [The robust variance's shape: the inputs' inverse cross-products around the residuals' spread], [@ch-regression],
  [Design effect (Moulton factor)], [How much related offers inflate a variance], [@ch-regression],
  [Effect heterogeneity; interaction], [The effect differs between groups; a product of inputs that measures the difference], [@ch-regression],
  [Offer-rate check; rarity], [The patch shouldn't change how often a card is offered; the card's rarity tier], [@ch-checks],
  [Pre-trend; event study], [Drift before the patch; the gap week by week], [@ch-did, @ch-checks],
  [Placebo test], [A test where the true effect is zero], [@ch-checks],
  [Upgrade-only tweak], [A change to the upgraded card only], [@ch-checks],
  [Anticipation; first-beta date; lead time], [Reacting at the beta notes; when they appeared; how long before stable], [@ch-checks],
  [Robustness check; sensitivity analysis], [Change one choice and see how far the answer moves], [@ch-checks],
  [Pseudo-treated card], [An unchanged card analysed as if changed], [@ch-placebo],
  [Standard normal], [What z should look like with honest errors and no effect], [@ch-placebo],
  [Robust sd (MAD)], [A spread measure a few outliers can't drag], [@ch-placebo],
  [Window–card pair], [One placebo comparison counted once], [@ch-placebo],
  [Calibration factor; calibrated z], [The placebo spread; z divided by it], [@ch-placebo],
  [Empirical p], [Share of a window's placebos at least as large as the real effect], [@ch-placebo],
  [Buff; nerf; toward the change], [Stronger; weaker; the effect's sign matches the change], [@ch-results],
  [Mixed-direction tweak], [Numbers moved both ways], [@ch-results, @ch-rulers],
  [Forest plot], [Every estimate with its interval, one row each], [@ch-results],
  [Ruler; ln(new/old)], [How a dose is measured; the primary ruler], [@ch-dose],
  [Meta-regression], [A regression across estimates, weighted by precision], [@ch-dose],
  [Between-card scatter (τ); random effects], [Real differences between cards beyond noise; the model that allows them], [@ch-dose],
  [Intercept], [The line's value at a dose of zero], [@ch-dose],
  [Slope per patch; z diff], [A separate line for each patch; how far apart, in SEs], [@ch-dose],
  [Sign, absolute, rank and per-kind rulers], [Other ways of measuring a dose], [@ch-rulers],
  [Post hoc], [Chosen after seeing the results], [@ch-rulers],
  [Measurement error; attenuation], [Noise in the dose; the flattening it causes], [@ch-rulers],
  [Leave-one-out; influential point], [Refit without each point; one that moves the answer], [@ch-rulers],
  [Statistical power; simulation], [The chance a real effect is detected; answering by fake data], [@ch-explanations],
  [Fake patch], [The analysis across builds with no card change], [@ch-explanations],
  [Regression to the mean], [Extreme values are followed by ordinary ones], [@ch-explanations],
  [Control scope], [Which unchanged cards are controls: same character or other characters], [@ch-did, @ch-explanations],
  [Player token; stayers], [An identifier for one upload route; players seen on both sides], [@ch-explanations],
  [Pre-declared analysis; negative control], [Written down before running; a comparison where nothing should happen], [@ch-explanations],
  [Instrument], [A random push on the treatment that affects the outcome only through it], [@ch-wins],
  [Intent-to-treat (ITT)], [The effect of being offered], [@ch-wins],
  [First stage], [How much the offer raises taking], [@ch-wins],
  [IV estimate (Wald, two-stage least squares)], [ITT divided by the first stage], [@ch-wins],
  [Relevance, independence, exclusion], [The three IV assumptions], [@ch-wins],
  [Balance check], [Offered and not-offered runs look alike before the offer], [@ch-wins],
  [First K screens; survival bias], [Only early screens count; later ones favour survivors], [@ch-wins],
  [Compliers; non-compliance; complier shift], [Runs that take the card when offered; those that don't; a change in who takes it], [@ch-wins],
  [Weak instrument (F < 10)], [A first stage too small to trust the IV estimate], [@ch-wins],
  [Partial pooling (hierarchical Bayes)], [Pulling noisy estimates toward the group], [@ch-open],
  [Staggered rollout], [The same change starting at different dates on beta and stable], [@ch-open],
  [Perception against strength], [Whether picks follow real strength], [@ch-open],
)

== Notation <app-notation>

Symbols in the order they first appear. The same letter means the same thing everywhere in the
guide, apart from letters used only inside one skippable derivation, which are not listed; a hat ($hat(beta)$) marks a number computed from data, a bar ($overline(y)$) an
average.

#small-table(
  columns: (auto, rest, auto),
  [*Symbol*], [*Meaning*], [*Where*],
  [$hat(theta)$; $overline(x)$], [A hat: computed from data (an estimate); a bar: an average], [@ch-project],
  [$i$; $r(i)$; $c(i)$], [One offer; its run; its card], [@ch-data],
  [$y_i$], [The outcome of offer $i$: one if picked, zero if not], [@ch-data],
  [$B(r)$; $W = (cal(B)^-, cal(B)^+)$], [A run's build; a window, the builds before and after], [@ch-data],
  [$"key"(r)$; $C_q$; $"hash"$], [A run's run key; the copies sharing key $q$; the hash function (SHA-256)], [@ch-data],
  [$"salt"$], [The secret key of the identifier hash], [@ch-data],
  [$N$; $L$], [A number of runs (records); bits kept of a hash], [@ch-data],
  [$cal(P)$; $cal(O)$; $cal(S)$], [Primary runs; the offers used; the card-reward sources], [@ch-data],
  [$N(B)$; $N_"min"$; $Delta_"cards"$], [Primary runs on a build; the thin-build threshold; card changes between two builds], [@ch-data],
  [$D_i$], [Treatment indicator: one if unit $i$ is treated (in a DiD, the treated card after the patch)], [@ch-confounding],
  [$Y_i (1)$, $Y_i (0)$; $tau_i$], [Potential outcomes with and without the treatment; their difference], [@ch-confounding],
  [$"E"[dot]$; $"E"[dot | D = 1]$], [An expectation (long-run average); the same over treated units only], [@ch-confounding],
  [$tau_"ATE"$; $tau_"ATT"$; $tau$], [Average effect over everyone; over the treated; the effect a design targets], [@ch-confounding],
  [$p$; $hat(p)$; $n$; $k$], [True pick probability; pick rate; offers; picks], [@ch-counting],
  [$p_0$, $p_1$], [A rate before and after (in @ch-regression, $p_0$ is the treated card's before-patch rate)], [@ch-counting],
  [$s^2$; $s$], [Variance and SD of a set of values (in @ch-regression, of one cell)], [@ch-counting],
  [$"Var"$; $"SD"$; $"Cov"$; $"SE"$], [Variance; standard deviation; covariance; standard error], [@ch-counting, @ch-noise],
  [$cal(N)(mu, sigma^2)$; $Z$; $Phi$], [Normal distribution; a standard normal variable; its cumulative probability], [@ch-noise],
  [$z$], [An estimate divided by its SE], [@ch-noise],
  [$theta$], [Any true value an estimate aims at (the generic symbol)], [@ch-noise],
  [$tilde(p)$; $"hw"$], [Wilson interval's centre and half-width], [@ch-noise],
  [$"Beta"(a, b)$], [The Beta distribution; the posterior for a rate is $"Beta"(1 + k, 1 + n - k)$], [@ch-noise],
  [$"bias"$; $"MSE"$; $sigma$], [Systematic error of an estimate; mean squared error; SD of one observation], [@ch-noise],
  [$T_i$; $A_i$], [Offer of the treated card; offer in the after block], [@ch-did],
  [$overline(y)_(t, s)$; $hat(tau)_"DiD"$], [Pick rate of the 2×2 cell with $T = t$, $A = s$; the DiD], [@ch-did],
  [$mu_(t, s)$], [A cell's untreated pick rate, $"E"[Y(0)]$ over its offers], [@ch-did],
  [$g_u$; $kappa$; $u$], [Gap to the controls in week $u$; drift per week; a week], [@ch-did],
  [$psi$], [Spillover: the patch's push on the controls' pick rate], [@ch-did],
  [$h$; $w$], [A shock to one card type; the share of the controls of the treated card's type], [@ch-did],
  [$x_i$; $a$, $b$; $epsilon_i$], [An input; a line's intercept and slope; what the line leaves over], [@ch-regression],
  [$e_i$], [Residual: outcome minus fitted value], [@ch-regression],
  [$overline(y)_1$, $overline(y)_0$], [Average outcome where a yes-or-no input is one, zero], [@ch-regression],
  [$D_i = T_i A_i$], [In the regression: the treated card after the patch (`treat_post`)], [@ch-regression],
  [$a, b, c, d$], [The 2×2 regression's coefficients; $d$ is the DiD], [@ch-regression],
  [$"card"_i, "upg"_i, "grp"_i, "blk"_i, "act"_i, "asc"_i$], [Offer $i$'s card, upgrade state, uploader group, block, act, ascension level], [@ch-regression],
  [$alpha, phi, gamma, delta, eta$], [Fixed effects: card × upgrade, card × group, block × group, act, ascension], [@ch-regression],
  [$beta$; $hat(beta)$], [The effect of the patch (coefficient on $D$); its estimate], [@ch-regression],
  [$X$; $K$; $bold(beta)$], [Design matrix; its number of columns; the vector of all coefficients], [@ch-regression],
  [$tilde(y)_i$, $tilde(D)_i$], [Outcome and $D$ with the fixed effects removed], [@ch-regression],
  [$hat(V)$; $hat(sigma)^2$], [Estimated variance of the coefficients; shared noise level (iid)], [@ch-regression],
  [$g$; $G$; $X_g$, $e_g$], [One run (cluster); the number of runs; one run's rows and residuals], [@ch-regression],
  [$rho$; $m$], [Correlation within a run; offers per run], [@ch-regression],
  [$H_i$; $lambda$; $w$], [High-band indicator; the interaction coefficient; the high band's share ($w$ is a share wherever it appears)], [@ch-regression],
  [$"logit"(p)$; $Delta$], [Log-odds, $ln(p slash (1 - p))$; a change in log-odds], [@ch-regression],
)
