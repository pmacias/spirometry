#import "../style.typ": *

= Glossary <app-glossary>

Terms in order of first appearance, with the chapter that defines them.

#small-table(
  columns: (auto, rest, auto),
  [*Term*], [*One-line meaning*], [*Where*],
  [Balance patch], [A game update that changes cards' numbers or rules], [@ch-project],
  [Card change], [One card's difference between two versions of the game], [@ch-project],
  [Run], [One game, from the first floor to a win or a death], [@ch-project],
  [Numeric tweak], [A change to a number on a card, rules unchanged], [@ch-project],
  [Rework], [A change to what a card does], [@ch-project],
  [Dose], [The size of a numeric tweak, on a fixed ruler], [@ch-project, @ch-dose],
  [Run file (record)], [The uploaded log of one run], [@ch-data],
  [Reward screen], [The choice of cards the game shows after a fight], [@ch-data],
  [Offer], [One card shown on a reward screen; picked or not], [@ch-data],
  [Build], [One game version, such as v0.103.2], [@ch-data],
  [Stable and beta branch], [The main release and the opt-in early-test release], [@ch-data],
  [Patch window; before and after block], [The builds compared around one change], [@ch-data],
  [Snapshot], [The downloaded copy of the export when the download finished], [@ch-data],
  [Backfill (upload lag)], [Runs uploaded long after they were played], [@ch-data],
  [Uploader group (tagged, untagged)], [Runs uploaded through the SlayTheStats mod, or not], [@ch-data],
  [Duplicate record; run key], [The same run uploaded twice; the label that finds it], [@ch-data],
  [Retried run], [Copies of one run with different endings], [@ch-data],
  [Sample and population], [The runs you have, and all the runs the question is about], [@ch-data],
  [Primary population], [The runs the main analysis uses, by fixed filters], [@ch-data],
  [Thin build; pooling], [A build too small to stand alone; counting it with a same-branch neighbour], [@ch-data],
  [Outcome], [What you measure (picked, won)], [@ch-confounding],
  [Treatment], [What you want the effect of (the patch, taking a card)], [@ch-confounding],
  [Confounder], [Something that drives both treatment and outcome (skill)], [@ch-confounding],
  [Selection], [Treated and untreated differ because of who chose], [@ch-confounding],
  [Causal effect; counterfactual], [What would change if only the treatment flipped; the world where it did], [@ch-confounding],
  [Pick rate; P(picked | offered)], [Picks divided by offers; the chance an offer is taken], [@ch-counting],
  [Percentage points against percent], [Subtracting rates against dividing them], [@ch-counting],
  [Mean; median], [The average; the middle value], [@ch-counting],
  [Variance; standard deviation], [How spread out values are; p(1 − p) for a yes-or-no outcome], [@ch-counting],
  [Standard error (SE)], [How far an estimate would move on a fresh sample], [@ch-noise],
  [Square-root rule], [The SE shrinks with the square root of the sample size], [@ch-noise],
  [95% confidence interval], [The estimate plus or minus about two SEs], [@ch-noise],
  [z], [The estimate divided by its SE], [@ch-noise],
  [Clearly nonzero], [|z| > 2; calibrated version in @ch-placebo], [@ch-noise],
  [Bias], [A systematic error that more data doesn't fix], [@ch-noise],
  [Multiple comparisons], [Test enough things and some pass by luck], [@ch-noise],
  [Difference-in-differences (DiD)], [The treated card's change minus the controls' change], [@ch-did],
  [Treated card; control cards], [The changed card; unchanged same-character cards], [@ch-did],
  [Control exclusions], [Same-character cards changed in the window, left out], [@ch-did],
  [Parallel trends], [Without the patch, the treated card would have moved like its controls], [@ch-did],
  [Fixed horizon (weeks 0–3)], [Only the first four after-weeks count], [@ch-did],
  [Regression; coefficient (β)], [A fitted relation; the effect of one input], [@ch-regression],
  [Linear probability model], [A regression on a yes-or-no outcome], [@ch-regression],
  [Fixed effects; singleton], [A separate baseline per group; a group with one observation], [@ch-regression],
  [iid, robust and clustered SE], [Error bars assuming independence; unequal noise; related offers within a run], [@ch-regression],
  [Odds; log-odds; delta method], [Picks per pass; their log; converting an SE between scales], [@ch-regression],
  [Offer-rate check; rarity], [The patch shouldn't change how often a card is offered; the card's rarity tier], [@ch-checks],
  [Pre-trend; event study], [Drift before the patch; the gap week by week], [@ch-checks],
  [Placebo test], [A test where the true effect is zero], [@ch-checks],
  [Upgrade-only tweak], [A change to the upgraded card only], [@ch-checks],
  [Anticipation; first-beta date; lead time], [Reacting at the beta notes; when they appeared; how long before stable], [@ch-checks],
  [Robustness check; sensitivity analysis], [Change one choice and see how far the answer moves], [@ch-checks],
  [Pseudo-treated card], [An unchanged card analysed as if changed], [@ch-placebo],
  [Standard normal], [What z should look like with honest errors and no effect], [@ch-placebo],
  [Robust sd (MAD)], [A spread measure a few outliers can't drag], [@ch-placebo],
  [Window–card pair], [One placebo comparison counted once], [@ch-placebo],
  [Calibration factor; calibrated z], [The placebo spread; z divided by it], [@ch-placebo],
  [Empirical p], [Share of a window's placebos at least as large as the real effect], [@ch-placebo],
  [Buff; nerf; toward the change], [Stronger; weaker; the effect's sign matches the change], [@ch-results],
  [Mixed-direction tweak], [Numbers moved both ways], [@ch-results, @ch-rulers],
  [Forest plot], [Every estimate with its interval, one row each], [@ch-results],
  [Ruler; ln(new/old)], [How a dose is measured; the primary ruler], [@ch-dose],
  [Meta-regression], [A regression across estimates, weighted by precision], [@ch-dose],
  [Between-card scatter (τ); random effects], [Real differences between cards beyond noise; the model that allows them], [@ch-dose],
  [Intercept], [The line's value at a dose of zero], [@ch-dose],
  [Slope per patch; z diff], [A separate line for each patch; how far apart, in SEs], [@ch-dose],
  [Sign, absolute, rank and per-kind rulers], [Other ways of measuring a dose], [@ch-rulers],
  [Post hoc], [Chosen after seeing the results], [@ch-rulers],
  [Measurement error; attenuation], [Noise in the dose; the flattening it causes], [@ch-rulers],
  [Leave-one-out; influential point], [Refit without each point; one that moves the answer], [@ch-rulers],
  [Statistical power; simulation], [The chance a real effect is detected; answering by fake data], [@ch-explanations],
  [Fake patch], [The analysis across builds with no card change], [@ch-explanations],
  [Regression to the mean], [Extreme values are followed by ordinary ones], [@ch-explanations],
  [Spillover (substitution); control scope], [A change to one card moves others; which cards are controls], [@ch-explanations],
  [Player token; stayers], [An identifier for one upload route; players seen on both sides], [@ch-explanations],
  [Pre-declared analysis; negative control], [Written down before running; a comparison where nothing should happen], [@ch-explanations],
  [Instrument], [A random push on the treatment that affects the outcome only through it], [@ch-wins],
  [Intent-to-treat (ITT)], [The effect of being offered], [@ch-wins],
  [First stage], [How much the offer raises taking], [@ch-wins],
  [IV estimate (Wald, two-stage least squares)], [ITT divided by the first stage], [@ch-wins],
  [Relevance, independence, exclusion], [The three IV assumptions], [@ch-wins],
  [Balance check], [Offered and not-offered runs look alike before the offer], [@ch-wins],
  [First K screens; survival bias], [Only early screens count; later ones favour survivors], [@ch-wins],
  [Compliers; non-compliance; complier shift], [Runs that take the card when offered; those that don't; a change in who takes it], [@ch-wins],
  [Weak instrument (F < 10)], [A first stage too small to trust the IV estimate], [@ch-wins],
  [Partial pooling (hierarchical Bayes)], [Pulling noisy estimates toward the group], [@ch-open],
  [Staggered rollout], [The same change starting at different dates on beta and stable], [@ch-open],
  [Perception against strength], [Whether picks follow real strength], [@ch-open],
)
